<% layout("layout/boilerplate") %>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

<body>

    <!-- =========================
         SHOW PAGE
    ========================== -->

    <div class="show-page-container">

        <!-- Main Listing Section -->
        <div class="show-main-row">

            <!-- LEFT: Listing Details -->
            <div class="show-details">

                <div class="show-heading">
                    <h3><%= listing.title %></h3>
                </div>

                <div class="show-card listing-card">

                    <div class="card-body">

                        <p class="show-owner">
                            <i>Owned by: <%= listing.owner.username %></i>
                        </p>

                        <p class="show-description">
                            <%= listing.description %>
                        </p>

                        <p class="show-price">
                            &#8377;<%= listing.price.toLocaleString("en-IN") %>
                        </p>

                        <p class="show-location">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= listing.location %>
                        </p>

                        <p class="show-country">
                            <%= listing.country %>
                        </p>

                    </div>

                </div>

                <!-- Edit / Delete Buttons -->
                <% if (currUser && listing.owner && currUser._id.toString() === listing.owner._id.toString()) { %>

                    <div class="btns show-action-buttons">

                        <a
                            href="/listings/<%= listing._id %>/edit"
                            class="btn btn-dark edit-btn"
                        >
                            Edit
                        </a>

                        <form
                            action="/listings/<%= listing._id %>?_method=DELETE"
                            method="post"
                        >
                            <button
                                id="deleteBTN"
                                class="btn btn-dark"
                                type="submit"
                            >
                                Delete
                            </button>
                        </form>

                    </div>

                <% } %>

            </div>


            <!-- RIGHT: Listing Image -->
            <div class="show-media">

                <div class="show-image-wrapper">

                    <img
                        src="<%= listing.image.url %>"
                        class="card-img-top show-img"
                        alt="Listing image"
                    >

                </div>

            </div>

        </div>


        <!-- =========================
             REVIEW SECTION
        ========================== -->

        <div class="show-reviews-section">

            <% if(currUser) { %>

                <hr>

                <h4>Leave a review</h4>

                <form
                    action="/listings/<%= listing._id %>/reviews"
                    method="POST"
                    novalidate
                    class="needs-validation review-form"
                >

                    <div class="mt-3 mb-3">

                        <label
                            for="rating"
                            class="form-lable"
                        >
                            Rating
                        </label>

                        <fieldset class="starability-fade">

                            <input
                                type="radio"
                                id="no-rate"
                                class="input-no-rate"
                                name="review[rating]"
                                value="1"
                                checked
                                aria-label="No rating."
                            />

                            <input
                                type="radio"
                                id="first-rate1"
                                name="review[rating]"
                                value="1"
                            />

                            <label
                                for="first-rate1"
                                title="Terrible"
                            >
                                1 star
                            </label>

                            <input
                                type="radio"
                                id="first-rate2"
                                name="review[rating]"
                                value="2"
                            />

                            <label
                                for="first-rate2"
                                title="Not good"
                            >
                                2 stars
                            </label>

                            <input
                                type="radio"
                                id="first-rate3"
                                name="review[rating]"
                                value="3"
                            />

                            <label
                                for="first-rate3"
                                title="Average"
                            >
                                3 stars
                            </label>

                            <input
                                type="radio"
                                id="first-rate4"
                                name="review[rating]"
                                value="4"
                            />

                            <label
                                for="first-rate4"
                                title="Very good"
                            >
                                4 stars
                            </label>

                            <input
                                type="radio"
                                id="first-rate5"
                                name="review[rating]"
                                value="5"
                            />

                            <label
                                for="first-rate5"
                                title="Amazing"
                            >
                                5 stars
                            </label>

                        </fieldset>

                    </div>


                    <div class="mt-3 mb-3">

                        <label
                            for="comment"
                            class="form-lable"
                        >
                            Comment
                        </label>

                        <textarea
                            name="review[comment]"
                            id="comment"
                            cols="30"
                            rows="5"
                            class="form-control"
                            required
                        ></textarea>

                        <div class="invalid-feedback">
                            Please submit some reviews
                        </div>

                    </div>


                    <button class="btn btn-outline-dark">
                        Submit
                    </button>

                </form>

                <hr>

            <% } %>


            <!-- =========================
                 ALL REVIEWS
            ========================== -->

            <% if(listing.reviews.length > 0) { %>

                <div class="reviews-wrapper">

                    <div class="reviews-heading">
                        <p><b>All Reviews</b></p>
                    </div>

                    <div class="reviews-grid">

                        <% for(review of listing.reviews) { %>

                            <div class="card review-card">

                                <div class="card-body">

                                    <h5 class="card-title">
                                        @<%= review.author.username %>
                                    </h5>

                                    <p class="card-text">
                                        <%= review.comment %>
                                    </p>

                                    <p
                                        class="starability-result"
                                        data-rating="<%= review.rating %>"
                                    ></p>

                                </div>


                                <form
                                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                    method="POST"
                                    class="review-delete-form"
                                >

                                    <button
                                        class="btn btn-sm btn-dark"
                                        type="submit"
                                    >
                                        Delete
                                    </button>

                                </form>

                            </div>

                        <% } %>

                    </div>

                </div>

            <% } %>

        </div>


        <!-- =========================
             MAP SECTION
        ========================== -->

        <div class="show-map-section">

            <h3>Where you'll be</h3>

            <div id="map"></div>

        </div>

    </div>


    <script src="/js/map.js"></script>

</body>